<Window x:Class="DeskLinkOsk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskLink OSK" Width="1030" Height="510" MinWidth="760" MinHeight="420"
        Background="#100C22" Foreground="#FFF7FF" WindowStartupLocation="CenterScreen" ShowActivated="False">
    <Window.Resources>
        <Style TargetType="Button" x:Key="KeyButton">
            <Setter Property="Margin" Value="3" /><Setter Property="MinHeight" Value="47" />
            <Setter Property="FontSize" Value="15" /><Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FFF7FF" /><Setter Property="Background" Value="#2A204A" />
            <Setter Property="BorderBrush" Value="#5F4C91" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="border" Property="Background" Value="#74E9C0" /><Setter TargetName="border" Property="BorderBrush" Value="#C6FFE9" /><Setter Property="Foreground" Value="#10233B" /></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="border" Property="Background" Value="#423568" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="DeskLink OSK" FontSize="29" FontWeight="Bold" /><TextBlock Text="Experimental native keyboard • every key is a named Windows button" Foreground="#CFC3EC" Margin="1,3,0,0" /></StackPanel>
            <CheckBox x:Name="AlwaysOnTopCheckBox" Grid.Column="1" Content="Always on top" VerticalAlignment="Center" FontSize="14" Checked="AlwaysOnTopChanged" Unchecked="AlwaysOnTopChanged" />
        </Grid>
        <Border Grid.Row="1" Background="#18112F" BorderBrush="#45366D" BorderThickness="1" CornerRadius="18" Padding="12"><StackPanel x:Name="KeyboardRows" VerticalAlignment="Center" /></Border>
        <Border Grid.Row="2" Margin="0,13,0,0" Background="#21193B" CornerRadius="11" Padding="12,8"><TextBlock x:Name="StatusText" Text="Ready. Click and hold a key to hold it down." Foreground="#D8CCF4" /></Border>
    </Grid>
</Window>
